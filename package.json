{
  "name": "verso",
  "version": "0.1.0",
  "description": "The other side of the page is meaning — YAML markup that renders HTML and publishes JSON-LD from the same tree",
  "type": "module",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "render": "node src/cli.js",
    "watch": "node src/cli.js --watch",
    "examples": "node examples/05-register-convention.js && node examples/06-custom-rpc.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "socket.io": "^4.8.1"
  }
}
